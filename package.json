{
  "name": "bili-live-api-bridge",
  "version": "4.6.0",
  "private": true,
  "type": "commonjs",
  "description": "Unofficial Bilibili live streaming API bridge and local WebUI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx bili-live-api.ts",
    "start:mock": "tsx bili-live-api.ts --mock",
    "start:live": "tsx bili-live-api.ts --live",
    "dev": "tsx watch bili-live-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@free-fonts/lxgw-wenkai": "1.0.1",
    "axios": "1.20.0",
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
